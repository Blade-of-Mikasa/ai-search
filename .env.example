# Nano AI Search 最小必填：复制为 .env，填入模型和 Tavily Key。
RAG_CHAT_ENDPOINT_URL=https://api.openai.com/v1/responses
RAG_CHAT_API_KEY=
RAG_CHAT_MODEL_ID=gpt-5.5
RAG_CHAT_MODEL_VERSION=2026-10
# DeepSeek 等默认启用思考的模型可设为 none，避免推理耗尽回答 token。
# RAG_CHAT_REASONING_EFFORT=none

# 推荐用独立 Tavily Basic Search 返回可引用网页来源。
RAG_WEB_SEARCH_PROVIDER=tavily
RAG_TAVILY_SEARCH_URL=https://api.tavily.com/search
RAG_TAVILY_API_KEY=
RAG_TAVILY_SEARCH_DEPTH=basic
RAG_ANSWER_WEB_MAX_ROUTES=2

# 使用支持内置 web_search 的 Responses endpoint 时，可改为：
# RAG_WEB_SEARCH_PROVIDER=openai
# RAG_WEB_SEARCH_MODEL_ID=gpt-5.5

# Python API -> C++ Core，只使用 HTTP + JSON。
RAG_CORE_HTTP_BASE_URL=http://127.0.0.1:8081

# 只有启用本地文档/图片/视频检索时才需要 Embedding。
# RAG_EMBEDDING_ENDPOINT_URL=https://api.openai.com/v1/embeddings
# RAG_EMBEDDING_API_KEY=
# RAG_EMBEDDING_MODEL_ID=text-embedding-3-small
# RAG_EMBEDDING_MODEL_VERSION=1
# RAG_EMBEDDING_DIMENSION=1536

# 下面均为上传与异步入库的可选配置，纯 Web AI Search 不需要。
# RAG_MYSQL_DSN=mysql+asyncmy://rag:rag@127.0.0.1:3306/nano_ai_search?charset=utf8mb4
# RAG_OBJECT_STORAGE_ENDPOINT_URL=http://127.0.0.1:9000
# RAG_OBJECT_STORAGE_ACCESS_KEY=
# RAG_OBJECT_STORAGE_SECRET_KEY=
# RAG_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
